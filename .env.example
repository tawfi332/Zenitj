# Copy this file to `.env` and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings -> API.
#
# The anon key is safe to ship in a client app — data is protected by
# Row Level Security (see supabase/migrations/0001_init.sql).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key
